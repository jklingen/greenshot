<UserControl x:Class="Greenshot.Editor.Mockup.ColorPickerField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8" /></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#CCCCCC"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,4,4" /><RectangleGeometry Rect="4,4,4,4" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <Button x:Name="SwatchButton" Width="48" Height="26" Padding="3" HorizontalAlignment="Left"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="SwatchButton_Click" ToolTip="Pick color">
            <Grid>
                <Rectangle Fill="{StaticResource CheckerBrush}" />
                <Rectangle x:Name="SwatchFill" Stroke="#555555" StrokeThickness="1" />
                <TextBlock x:Name="MixedMark" Text="&#x2260;" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Button>        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" StaysOpen="False" Closed="PickerPopup_Closed" AllowsTransparency="False">
            <Border Background="#F2F2F2" BorderBrush="#777777" BorderThickness="1" Padding="10" Width="236">
                <StackPanel>
                    <Grid x:Name="SvArea" Width="210" Height="150" Cursor="Cross" Background="Red"
                          MouseLeftButtonDown="SvArea_MouseDown" MouseMove="SvArea_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" />
                        </Canvas>
                    </Grid>
                    <Grid x:Name="HueBar" Width="210" Height="16" Margin="0,8,0,0" Cursor="Hand"
                          MouseLeftButtonDown="HueBar_MouseDown" MouseMove="HueBar_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="HueMarker" Width="4" Height="16" Stroke="Black" Fill="White" />
                        </Canvas>
                    </Grid>
                    <Grid x:Name="AlphaBar" Width="210" Height="16" Margin="0,8,0,0" Cursor="Hand"
                          MouseLeftButtonDown="AlphaBar_MouseDown" MouseMove="AlphaBar_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                        <Rectangle Fill="{StaticResource CheckerBrush}" />
                        <Rectangle x:Name="AlphaGradient" />
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="AlphaMarker" Width="4" Height="16" Stroke="Black" Fill="White" />
                        </Canvas>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="24" BorderBrush="#555555" BorderThickness="1">
                            <Grid>
                                <Rectangle Fill="{StaticResource CheckerBrush}" />
                                <Rectangle x:Name="PreviewRect" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="AlphaText" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>                    <TextBlock Text="Hex (#AARRGGBB)" Margin="0,8,0,2" />
                    <TextBox x:Name="HexTextBox" KeyDown="HexTextBox_KeyDown" LostFocus="HexTextBox_LostFocus" />
                </StackPanel>
            </Border>
        </Popup>
        <ItemsControl x:Name="RecentList" Margin="0,6,0,0" HorizontalAlignment="Left" Width="190">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="16" Height="16" Margin="0,0,2,2" Padding="0" Background="{Binding}"
                            BorderBrush="#555555" ToolTip="{Binding Color}" Click="RecentColor_Click" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>