<Window x:Class="Greenshot.Editor.Mockup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Greenshot.Editor.Mockup"
        Title="Greenshot Editor Mock-up"
        Width="1100"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F2F2F2" Padding="10">
            <DockPanel LastChildFill="True">
                <Button x:Name="OpenImageButton"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0"
                        Padding="12,6"
                        Click="OpenImageButton_Click">Open image...</Button>
                <Button x:Name="ShortcutsButton" DockPanel.Dock="Right" Padding="12,6" Click="ShortcutsButton_Click" AutomationProperties.Name="Keyboard shortcuts">Keyboard shortcuts</Button>
                <Popup x:Name="ShortcutsPopup" PlacementTarget="{Binding ElementName=ShortcutsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#BBBBBB" BorderThickness="1" Padding="14" Margin="0,4,0,8" CornerRadius="6">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" /></Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="Keyboard shortcuts (canvas focused)" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Arrows" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Move selection by 1 px" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Text="Shift+Arrows" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Move selection by 10 px" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="3" Text="Alt+Arrows" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Resize by 1 px (right/down = larger)" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="4" Text="Alt+Shift+Arrows" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Resize by 10 px" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="5" Text="Tab / Shift+Tab" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Select next / previous element" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="6" Text="Space" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Toggle element at focus in selection" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="7" Text="Ctrl+A" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Select all" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="8" Text="Enter" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Jump to Layout fields" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="9" Text="F2 or just type" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="Add / edit text of selected element" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="10" Text="Esc" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="Finish text editing / clear selection" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="11" Text="Delete" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="Delete selection" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="12" Text="F6" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="Switch toolbar / canvas / panel" Foreground="#555555" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="13" Text="Shift+click" FontWeight="SemiBold" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="13" Grid.Column="1" Text="Add element to selection" Foreground="#555555" Margin="0,0,0,4" />
                        </Grid>
                    </Border>
                </Popup>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Drawing mode" VerticalAlignment="Center" Margin="14,0,5,0" />
                    <ComboBox x:Name="ModeSelector"
                              MinWidth="130"
                              SelectedIndex="1"
                              SelectionChanged="ModeSelector_SelectionChanged">
                        <ComboBoxItem Content="Tool then drag" Tag="Classic" />
                        <ComboBoxItem Content="Click to add" Tag="ClickToAdd" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DockColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F2F2F2" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Padding="6">
                <StackPanel x:Name="ToolsPanel">
                    <StackPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Width" Value="36" />
                            <Setter Property="Height" Value="36" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style TargetType="Path">
                            <Setter Property="Stroke" Value="#222222" />
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="Stretch" Value="None" />
                        </Style>
                    </StackPanel.Resources>
                    <ToggleButton x:Name="SelectToolButton" Tag="Select" ToolTip="Select" IsChecked="True" Click="Tool_Click">
                        <Path Data="M 4,2 L 4,18 L 8,14 L 11,21 L 14,20 L 11,13 L 17,13 Z" Fill="#222222" StrokeThickness="1" />
                    </ToggleButton>
                    <ToggleButton Tag="Rectangle" ToolTip="Rectangle" Click="Tool_Click">
                        <Path Data="M 3,5 H 19 V 17 H 3 Z" />
                    </ToggleButton>
                    <ToggleButton Tag="Ellipse" ToolTip="Ellipse" Click="Tool_Click">
                        <Path Data="M 3,11 A 8,6 0 1 0 19,11 A 8,6 0 1 0 3,11 Z" />
                    </ToggleButton>
                    <ToggleButton Tag="Line" ToolTip="Line" Click="Tool_Click">
                        <Path Data="M 3,19 L 19,3" />
                    </ToggleButton>
                    <ToggleButton Tag="Arrow" ToolTip="Arrow" Click="Tool_Click">
                        <Path Data="M 3,19 L 18,4 M 9,4 H 18 V 13" />
                    </ToggleButton>
                    <ToggleButton Tag="Text" ToolTip="Text" Click="Tool_Click">
                        <TextBlock Text="T" FontSize="20" FontWeight="Bold" FontFamily="Serif" />
                    </ToggleButton>
                    <ToggleButton Tag="Freehand" ToolTip="Freehand" Click="Tool_Click">
                        <Path Data="M 3,16 C 6,2 10,2 11,11 S 16,18 19,6" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border x:Name="CanvasHost" Grid.Column="1" Margin="24,24,0,24" Background="#383838" Padding="16" Focusable="True" FocusVisualStyle="{x:Null}" BorderBrush="Transparent" BorderThickness="2" AutomationProperties.Name="Drawing canvas" KeyDown="CanvasHost_KeyDown" PreviewTextInput="CanvasHost_PreviewTextInput" GotKeyboardFocus="CanvasHost_FocusChanged" LostKeyboardFocus="CanvasHost_FocusChanged">

                <Viewbox Stretch="Uniform">
                    <Grid x:Name="ImageCoordinateSpace" Width="1200" Height="800">
                        <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True" />
                        <Canvas x:Name="AnnotationCanvas"
                                Width="1200"
                                Height="800"
                                Background="Transparent"
                                MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                MouseMove="AnnotationCanvas_MouseMove"
                                MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp" />
                    </Grid>
                </Viewbox>
            </Border>

            <Border x:Name="PropertiesDockHost" Grid.Column="2" Margin="24,24,0,24" Background="#F2F2F2" Padding="12">
                <DockPanel x:Name="PropertiesPanel">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="UndockButton" DockPanel.Dock="Right" Padding="8,2" Click="UndockButton_Click">Undock</Button>
                        <TextBlock Text="Properties" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NoSelectionText" Text="No selection" />
                            <StackPanel x:Name="PropertiesFields" Margin="0,4,0,0">
                            <StackPanel.Resources>
                                <Style TargetType="Expander">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <DockPanel>
                                                    <ToggleButton x:Name="HeaderBar" DockPanel.Dock="Top"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Cursor="Hand" Focusable="False">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="Bar" Background="#D0D0D0" BorderBrush="#A8A8A8" BorderThickness="0,0,0,1" Padding="6,4">
                                                                    <DockPanel>
                                                                        <Path x:Name="Arrow" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                              Data="M 0,0 L 4,4 L 8,0" Stroke="#333333" StrokeThickness="1.5" />
                                                                        <ContentPresenter TextElement.FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="False">
                                                                        <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 4,4 L 0,8" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bar" Property="Background" Value="#C2C2C2" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <ContentPresenter ContentSource="Header" />
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="Content" Margin="2,0,2,0" />
                                                </DockPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="False">
                                                        <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                                <Expander x:Name="LayoutExpander" Header="Layout" IsExpanded="True" Margin="0,0,0,8">
                                    <Grid Margin="4,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,4,6" />
                                        <TextBox x:Name="PositionXTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6"
                                                 LostFocus="GeometryProperty_LostFocus" KeyDown="GeometryProperty_KeyDown" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,4,6" />
                                        <TextBox x:Name="PositionYTextBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"
                                                 LostFocus="GeometryProperty_LostFocus" KeyDown="GeometryProperty_KeyDown" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="W" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox x:Name="WidthTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                                                 LostFocus="GeometryProperty_LostFocus" KeyDown="GeometryProperty_KeyDown" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="H" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox x:Name="HeightTextBox" Grid.Row="1" Grid.Column="3"
                                                 LostFocus="GeometryProperty_LostFocus" KeyDown="GeometryProperty_KeyDown" />
                                    </Grid>
                                </Expander>
                                <Expander Header="Line and fill" IsExpanded="True">
                                    <Grid Margin="4,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Line color" Margin="0,4,0,0" />
                                        <local:ColorPickerField x:Name="LineColorPicker" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Left" ColorPicked="LineColorPicker_ColorPicked" />
                                        <TextBlock Grid.Row="1" Text="Line thickness" VerticalAlignment="Center" />
                                        <TextBox x:Name="LineThicknessTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                                 LostFocus="LineThicknessProperty_LostFocus" KeyDown="LineThicknessProperty_KeyDown" />
                                        <TextBlock Grid.Row="2" Text="Fill color" Margin="0,4,0,0" />
                                        <local:ColorPickerField x:Name="FillColorPicker" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" ColorPicked="FillColorPicker_ColorPicked" />
                                    </Grid>
                                </Expander>
                                <Expander x:Name="TextPropertiesExpander" Header="Text" IsExpanded="True" Margin="0,8,0,0">
                                    <Grid Margin="4,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Font" VerticalAlignment="Center" />
                                        <ComboBox x:Name="TextFontFamilyComboBox" Grid.Row="0" Grid.Column="1" IsEditable="True"
                                                  LostFocus="TextFontFamily_LostFocus" KeyDown="TextProperty_KeyDown" />
                                        <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <TextBox x:Name="TextFontSizeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                                 LostFocus="TextFontSize_LostFocus" KeyDown="TextProperty_KeyDown" />
                                        <TextBlock Grid.Row="2" Text="Color" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <local:ColorPickerField x:Name="TextColorPicker" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                                                HorizontalAlignment="Left" ColorPicked="TextColorPicker_ColorPicked" />
                                        <TextBlock Grid.Row="3" Text="Style" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <ToggleButton x:Name="BoldTextButton" Content="B" FontWeight="Bold" Width="30" Click="TextStyleButton_Click" Tag="Bold" />
                                            <ToggleButton x:Name="ItalicTextButton" Content="I" FontStyle="Italic" Width="30" Margin="4,0,0,0" Click="TextStyleButton_Click" Tag="Italic" />
                                            <ToggleButton x:Name="UnderlineTextButton" Width="30" Margin="4,0,0,0" Click="TextStyleButton_Click" Tag="Underline">
                                                <TextBlock Text="U" TextDecorations="Underline" />
                                            </ToggleButton>
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Text="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="4" Text="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <ToggleButton x:Name="AlignLeftButton" Tag="Left" Width="30" Height="26" Margin="0" ToolTip="Align left" AutomationProperties.Name="Align left" Click="TextAlignmentButton_Click">
                                                <Path Data="M0,2 H14 M0,7 H9 M0,12 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" />
                                            </ToggleButton>
                                            <ToggleButton x:Name="AlignCenterButton" Tag="Center" Width="30" Height="26" Margin="4,0,0,0" ToolTip="Align center" AutomationProperties.Name="Align center" Click="TextAlignmentButton_Click">
                                                <Path Data="M0,2 H14 M2.5,7 H11.5 M1,12 H13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" />
                                            </ToggleButton>
                                            <ToggleButton x:Name="AlignRightButton" Tag="Right" Width="30" Height="26" Margin="4,0,0,0" ToolTip="Align right" AutomationProperties.Name="Align right" Click="TextAlignmentButton_Click">
                                                <Path Data="M0,2 H14 M5,7 H14 M2,12 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" />
                                            </ToggleButton>
                                        </StackPanel>
                                        <TextBlock Grid.Row="5" Text="Vertical" VerticalAlignment="Center" Margin="0,8,0,0" />
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                            <ToggleButton x:Name="AlignTopButton" Tag="Top" Width="30" Height="26" Margin="0" ToolTip="Align top" AutomationProperties.Name="Align top" Click="TextAlignmentButton_Click">
                                                <Path Data="M0,0 H14 M3,4 H11 M3,7 H11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" />
                                            </ToggleButton>
                                            <ToggleButton x:Name="AlignMiddleButton" Tag="Center" Width="30" Height="26" Margin="4,0,0,0" ToolTip="Align middle" AutomationProperties.Name="Align middle" Click="TextAlignmentButton_Click">
                                                <Path Data="M0,0.5 H14 M3,4 H11 M3,7 H11 M0,13.5 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" />
                                            </ToggleButton>
                                            <ToggleButton x:Name="AlignBottomButton" Tag="Bottom" Width="30" Height="26" Margin="4,0,0,0" ToolTip="Align bottom" AutomationProperties.Name="Align bottom" Click="TextAlignmentButton_Click">
                                                <Path Data="M3,5 H11 M3,8 H11 M0,12 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" />
                                            </ToggleButton>
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F2F2F2" Padding="10,5">
            <TextBlock x:Name="StatusText" />
        </Border>
    </Grid>
</Window>
