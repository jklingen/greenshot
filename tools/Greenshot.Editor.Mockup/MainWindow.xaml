<Window x:Class="Greenshot.Editor.Mockup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Greenshot Editor Mock-up"
        Width="1100"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F2F2F2" Padding="10">
            <DockPanel LastChildFill="True">
                <Button x:Name="OpenImageButton"
                        DockPanel.Dock="Left"
                        Margin="0,0,12,0"
                        Padding="12,6"
                        Click="OpenImageButton_Click">Open image...</Button>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SelectToolButton" Content="Select" Tag="Select" GroupName="AnnotationTools" IsChecked="True" Checked="Tool_Checked" Margin="4,0" />
                    <RadioButton Content="Rectangle" Tag="Rectangle" GroupName="AnnotationTools" Checked="Tool_Checked" Margin="4,0" />
                    <RadioButton Content="Ellipse" Tag="Ellipse" GroupName="AnnotationTools" Checked="Tool_Checked" Margin="4,0" />
                    <RadioButton Content="Line" Tag="Line" GroupName="AnnotationTools" Checked="Tool_Checked" Margin="4,0" />
                    <RadioButton Content="Arrow" Tag="Arrow" GroupName="AnnotationTools" Checked="Tool_Checked" Margin="4,0" />
                    <RadioButton Content="Text" Tag="Text" GroupName="AnnotationTools" Checked="Tool_Checked" Margin="4,0" />
                    <RadioButton Content="Freehand" Tag="Freehand" GroupName="AnnotationTools" Checked="Tool_Checked" Margin="4,0" />
                    <TextBlock Text="Drawing mode" VerticalAlignment="Center" Margin="14,0,5,0" />
                    <ComboBox x:Name="ModeSelector"
                              MinWidth="130"
                              SelectedIndex="0"
                              SelectionChanged="ModeSelector_SelectionChanged">
                        <ComboBoxItem Content="Tool then drag" Tag="Classic" />
                        <ComboBoxItem Content="Click to add" Tag="ClickToAdd" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#383838" Padding="16">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="ImageCoordinateSpace" Width="1200" Height="800">
                        <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True" />
                        <Canvas x:Name="AnnotationCanvas"
                                Width="1200"
                                Height="800"
                                Background="Transparent"
                                MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                                MouseMove="AnnotationCanvas_MouseMove"
                                MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp" />
                    </Grid>
                </Viewbox>
            </Border>

            <Border Grid.Column="1" Margin="16,0,0,0" Background="#F2F2F2" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="NoSelectionText" Text="No selection" />
                        <StackPanel x:Name="PropertiesFields" IsEnabled="False" Margin="0,4,0,0">
                            <TextBlock Text="Position X" Margin="0,8,0,2" />
                            <TextBox x:Name="PositionXTextBox"
                                     LostFocus="GeometryProperty_LostFocus"
                                     KeyDown="GeometryProperty_KeyDown" />
                            <TextBlock Text="Position Y" Margin="0,8,0,2" />
                            <TextBox x:Name="PositionYTextBox"
                                     LostFocus="GeometryProperty_LostFocus"
                                     KeyDown="GeometryProperty_KeyDown" />
                            <TextBlock Text="Width" Margin="0,8,0,2" />
                            <TextBox x:Name="WidthTextBox"
                                     LostFocus="GeometryProperty_LostFocus"
                                     KeyDown="GeometryProperty_KeyDown" />
                            <TextBlock Text="Height" Margin="0,8,0,2" />
                            <TextBox x:Name="HeightTextBox"
                                     LostFocus="GeometryProperty_LostFocus"
                                     KeyDown="GeometryProperty_KeyDown" />
                            <TextBlock Text="Line color" Margin="0,8,0,2" />
                            <TextBox x:Name="LineColorTextBox"
                                     LostFocus="ColorProperty_LostFocus"
                                     KeyDown="ColorProperty_KeyDown" />
                            <TextBlock Text="Fill color" Margin="0,8,0,2" />
                            <TextBox x:Name="FillColorTextBox"
                                     LostFocus="ColorProperty_LostFocus"
                                     KeyDown="ColorProperty_KeyDown" />
                            <TextBlock Text="Line thickness" Margin="0,8,0,2" />
                            <TextBox x:Name="LineThicknessTextBox"
                                     LostFocus="LineThicknessProperty_LostFocus"
                                     KeyDown="LineThicknessProperty_KeyDown" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F2F2F2" Padding="10,5">
            <TextBlock x:Name="StatusText" />
        </Border>
    </Grid>
</Window>
